# Data is not redistributed: it is retrieved from the GDC by R/01, and the
# TCGA data use terms govern it rather than this repository's licence.
data/
logs/

# The GDC download cache, wherever a user points GDC_DIR.
GDCdata/

# Results and figures are regenerated by run_all.R.
results/
figures/

# TCGAbiolinks writes these into the working directory during GDCquery.
/df.rds
/results.rds

# Manuscript drafts and renders. Kept beside the analysis while it is being
# written; not part of the published analysis.
manuscript/
README.html
README.pdf

# R session detritus
.Rhistory
.RData
.Rproj.user/
*.Rproj

# Editor / OS
.DS_Store
*~
